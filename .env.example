# Copy to .env and fill in. Used by `quiz run` (docker compose reads .env).

# Gemini (default provider)
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-2.5-flash)
ORACLE_QUIZ_GEMINI_MODEL=

# OpenAI or any OpenAI-compatible endpoint (provider "openai")
OPENAI_API_KEY=
# e.g. http://localhost:11434/v1 for a local Ollama server
OPENAI_BASE_URL=
ORACLE_QUIZ_OPENAI_MODEL=
